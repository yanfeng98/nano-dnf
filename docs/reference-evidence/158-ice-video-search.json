{
  "script": "from pathlib import Path\nimport json,cv2,numpy as np\nfrom PIL import Image,ImageDraw\ncv2.setNumThreads(1)\nr=json.load(open('docs/reference-evidence/157-native-missiles.json'));a=Image.open('docs/reference-evidence/157-native-missiles-raw.png')\nf=r['files']['passiveobject/common/animation/icemissile1.ani']['animation']['frames'];templates=[]\nfor i,fr in enumerate(f):\n m=fr['bitmapEvidence'];tile=m['tile'];x,y=r['tiles'][tile]['pasteXY'];w,h=m['size'];im=a.crop((x,y,x+w,y+h))\n for scale in [1,1.125]:\n  pic=np.array(im.resize((round(w*scale),round(h*scale)),Image.Resampling.BILINEAR));mask=(pic[:,:,3]>190).astype('uint8')*255\n  templates.append((i,scale,pic[:,:,:3][:,:,::-1].copy(),mask))\nrows=[]\nfor p in sorted(Path('/tmp/nano158-v1-blue').glob('*-second-room.png')):\n im=cv2.imread(str(p));roi=im[280:480,200:700];best={'score':-1}\n for idx,scale,pic,mask in templates:\n  q=cv2.matchTemplate(roi,pic,cv2.TM_CCOEFF_NORMED,mask=mask);q=np.nan_to_num(q,nan=-1,posinf=-1,neginf=-1)\n  _,score,_,(x,y)=cv2.minMaxLoc(q)\n  if score>best['score']:best={'frame':p.name,'score':score,'xy':[x+200,y+280],'idx':idx,'scale':scale,'wh':[pic.shape[1],pic.shape[0]]}\n rows.append(best)\njson.dump(rows,open('/tmp/nano158-ice-search.json','w'),indent=2)\nfor row in sorted(rows,key=lambda r:-r['score'])[:12]:print(row)\n",
